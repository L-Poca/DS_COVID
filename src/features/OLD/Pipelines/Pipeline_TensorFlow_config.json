    "fast_prototype": {
      "name": "Prototype Rapide",
      "description": "Modèle léger pour tests et prototypage rapide",
      "architecture_type": "custom_cnn",
      "architecture_params": {
        "input_shape": [128, 128, 3],
        "num_classes": 4,
