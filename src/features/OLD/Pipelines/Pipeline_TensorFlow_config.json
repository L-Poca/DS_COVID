          {"filters": 16, "kernel_size": 3, "pool_size": 2},
          {"filters": 32, "kernel_size": 3, "pool_size": 2}
        ],
        "dense_layers": [64],
        "activation": "relu",
        "batch_normalization": false,
        "conv_dropout": 0.1,
        "dense_dropout": 0.2
      },
      "compile_config": {
        "optimizer": "adam",
        "learning_rate": 0.01,
