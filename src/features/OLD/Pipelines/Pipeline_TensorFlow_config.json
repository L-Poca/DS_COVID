        "lr_patience": 4,
        "tensorboard": true
      },
      "data_config": {
        "target_size": [224, 224],
        "batch_size": 24,
        "rotation_range": 12,
        "zoom_range": 0.08,
        "horizontal_flip": true,
        "width_shift_range": 0.1,
        "height_shift_range": 0.1
      }
    },
    
    "densenet_covid": {
      "name": "DenseNet COVID Spécialisé",
      "description": "DenseNet121 spécialement configuré pour la détection COVID",
      "architecture_type": "transfer_learning",
      "architecture_params": {
        "base_model": "DenseNet121",
        "input_shape": [224, 224, 3],
        "num_classes": 4,
        "fine_tuning": true,
        "freeze_layers": 200,
        "rescaling": true,
        "data_augmentation": false,
        "global_pooling": "avg",
        "dense_layers": [512, 256, 128],
        "dropout": 0.5,
        "dense_dropout": 0.4
      },
      "compile_config": {
        "optimizer": "rmsprop",
        "learning_rate": 5e-5,
        "loss": "categorical_crossentropy"
      },
      "training_config": {
        "epochs": 80,
        "save_best_model": true,
        "early_stopping": true,
        "patience": 15,
        "reduce_lr": true,
        "lr_factor": 0.1,
        "lr_patience": 8,
        "tensorboard": true
      },
      "data_config": {
        "target_size": [224, 224],
        "batch_size": 20,
        "rotation_range": 8,
        "zoom_range": 0.05,
        "horizontal_flip": true,
        "brightness_range": [0.95, 1.05]
      }
    },
    
    "mobilenet_lightweight": {
      "name": "MobileNet Léger",
      "description": "MobileNetV2 pour déploiement mobile/edge computing",
      "architecture_type": "transfer_learning",
      "architecture_params": {
        "base_model": "MobileNetV2",
        "input_shape": [224, 224, 3],
        "num_classes": 4,
        "fine_tuning": false,
        "freeze_layers": 100,
        "rescaling": true,
        "data_augmentation": true,
        "global_pooling": "avg",
        "dense_layers": [128],
        "dropout": 0.2,
        "dense_dropout": 0.2
      },
      "compile_config": {
        "optimizer": "adam",
        "learning_rate": 0.001,
        "loss": "categorical_crossentropy"
      },
      "training_config": {
        "epochs": 40,
        "save_best_model": true,
        "early_stopping": true,
        "patience": 8,
        "reduce_lr": true,
        "lr_factor": 0.3,
        "lr_patience": 4,
        "tensorboard": false
      },
      "data_config": {
        "target_size": [224, 224],
        "batch_size": 64,
        "rotation_range": 10,
        "zoom_range": 0.1,
        "horizontal_flip": true
      }
    },
    
    "ensemble_voting": {
      "name": "Ensemble Voting",
      "description": "Ensemble de modèles avec vote majoritaire",
      "architecture_type": "ensemble",
      "architecture_params": {
        "input_shape": [224, 224, 3],
        "num_classes": 4,
        "ensemble_strategy": "average",
        "base_models": [
          {
            "type": "transfer",
            "base_model": "VGG16",
            "fine_tuning": false,
            "global_pooling": "avg",
            "dense_layers": [256],
            "dropout": 0.3
          },
          {
            "type": "transfer",
            "base_model": "ResNet50",
            "fine_tuning": false,
            "global_pooling": "avg",
            "dense_layers": [256],
            "dropout": 0.3
          },
          {
            "type": "cnn",
            "conv_blocks": [
              {"filters": 64, "kernel_size": 3, "pool_size": 2},
              {"filters": 128, "kernel_size": 3, "pool_size": 2},
              {"filters": 256, "kernel_size": 3, "pool_size": 2}
            ],
            "dense_layers": [256],
            "batch_normalization": true,
            "conv_dropout": 0.25,
            "dense_dropout": 0.3
          }
        ]
      },
      "compile_config": {
        "optimizer": "adam",
        "learning_rate": 0.0001,
        "loss": "categorical_crossentropy"
      },
      "training_config": {
        "epochs": 30,
        "save_best_model": true,
        "early_stopping": true,
        "patience": 8,
        "reduce_lr": false,
        "tensorboard": true
      },
      "data_config": {
        "target_size": [224, 224],
        "batch_size": 16,
        "rotation_range": 10,
        "zoom_range": 0.1,
        "horizontal_flip": true
      }
    },
    
    "binary_covid_detector": {
      "name": "Détecteur Binaire COVID",
      "description": "Classification binaire COVID vs Non-COVID",
      "architecture_type": "transfer_learning",
      "architecture_params": {
        "base_model": "VGG16",
        "input_shape": [224, 224, 3],
        "num_classes": 2,
        "fine_tuning": true,
        "freeze_layers": 10,
        "rescaling": true,
        "data_augmentation": false,
        "global_pooling": "avg",
        "dense_layers": [512, 256],
        "dropout": 0.5,
        "dense_dropout": 0.4
      },
      "compile_config": {
        "optimizer": "adam",
        "learning_rate": 1e-4,
        "loss": "binary_crossentropy"
      },
      "training_config": {
        "epochs": 50,
        "save_best_model": true,
        "early_stopping": true,
        "patience": 10,
        "reduce_lr": true,
        "lr_factor": 0.2,
        "lr_patience": 5,
        "tensorboard": true
      },
      "data_config": {
        "target_size": [224, 224],
        "batch_size": 32,
        "class_mode": "binary",
        "rotation_range": 15,
        "zoom_range": 0.1,
        "horizontal_flip": true
      }
    },
    
    "high_resolution_cnn": {
