      },
      "training_config": {
        "epochs": 60,
        "save_best_model": true,
        "early_stopping": true,
        "patience": 12,
        "reduce_lr": true,
        "lr_factor": 0.1,
        "lr_patience": 6,
        "tensorboard": true
      },
      "data_config": {
        "target_size": [512, 512],
        "batch_size": 8,
        "color_mode": "grayscale",
        "rotation_range": 5,
        "zoom_range": 0.05,
        "horizontal_flip": true
      }
