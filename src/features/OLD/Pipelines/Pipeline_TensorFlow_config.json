      },
      "training_config": {
        "epochs": 10,
        "save_best_model": false,
        "early_stopping": false,
        "reduce_lr": false,
        "tensorboard": false
      },
      "data_config": {
        "target_size": [128, 128],
        "batch_size": 64,
        "rotation_range": 10,
        "horizontal_flip": true
      }
    }
  },
  
  "model_saving": {
    "output_directory": "models/tensorflow/",
    "save_format": "h5",
    "save_weights_only": false,
    "include_optimizer": false,
    "save_traces": true,
    "naming_convention": "{model_name}_{timestamp}",
    "create_backup": true,
    "compress": false
  },
  
  "performance_settings": {
    "mixed_precision": false,
    "xla_acceleration": false,
    "multi_gpu": false,
    "distribution_strategy": null,
    "memory_growth": true,
    "allow_soft_placement": true,
    "log_device_placement": false
  },
  
  "data_pipeline": {
    "prefetch_buffer": "AUTOTUNE",
    "num_parallel_calls": "AUTOTUNE",
    "cache_dataset": false,
    "shuffle_buffer_size": 1000,
    "repeat_dataset": false,
    "drop_remainder": false
  },
  
  "regularization": {
    "l1_regularization": 0.0,
    "l2_regularization": 0.0001,
    "dropout_schedule": false,
    "batch_norm_momentum": 0.99,
    "batch_norm_epsilon": 1e-3,
    "label_smoothing": 0.0
  },
  
  "augmentation_presets": {
    "medical_conservative": {
      "rotation_range": 5,
      "width_shift_range": 0.05,
      "height_shift_range": 0.05,
      "zoom_range": 0.05,
      "horizontal_flip": true,
      "vertical_flip": false,
      "brightness_range": [0.95, 1.05]
    },
    "medical_moderate": {
      "rotation_range": 10,
      "width_shift_range": 0.1,
      "height_shift_range": 0.1,
      "zoom_range": 0.1,
      "horizontal_flip": true,
      "vertical_flip": false,
      "brightness_range": [0.9, 1.1],
      "shear_range": 0.05
    },
    "medical_aggressive": {
      "rotation_range": 20,
      "width_shift_range": 0.2,
      "height_shift_range": 0.2,
      "zoom_range": 0.2,
      "horizontal_flip": true,
      "vertical_flip": true,
      "brightness_range": [0.8, 1.2],
      "shear_range": 0.1,
      "channel_shift_range": 0.1
    }
  },
  
  "evaluation_metrics": {
    "classification_metrics": [
      "accuracy",
      "precision",
      "recall",
      "f1_score",
      "auc"
    ],
    "per_class_metrics": true,
    "confusion_matrix": true,
    "classification_report": true,
    "roc_curves": true,
    "precision_recall_curves": true
  },
  
  "callbacks_config": {
    "early_stopping": {
      "monitor": "val_accuracy",
      "patience": 10,
      "restore_best_weights": true,
      "verbose": 1
    },
    "model_checkpoint": {
      "monitor": "val_accuracy",
      "save_best_only": true,
      "save_weights_only": false,
      "verbose": 1
    },
    "reduce_lr_on_plateau": {
      "monitor": "val_loss",
      "factor": 0.2,
      "patience": 5,
      "min_lr": 1e-7,
      "verbose": 1
    },
    "csv_logger": {
      "append": true,
      "separator": ","
    },
    "tensorboard": {
      "write_graph": true,
      "write_images": false,
      "histogram_freq": 1,
      "update_freq": "epoch"
    }
  },
  
  "medical_specific_settings": {
    "dicom_support": false,
    "hu_windowing": false,
    "lung_segmentation": false,
    "contrast_enhancement": true,
    "noise_reduction": false,
    "anonymization": true,
    "metadata_preservation": false
  },
  
  "deployment": {
    "target_platforms": ["tensorflow_serving", "tflite", "tensorflowjs"],
    "quantization": false,
    "pruning": false,
    "optimization_level": "default",
    "input_signature": true,
    "batch_inference": true
  }
}