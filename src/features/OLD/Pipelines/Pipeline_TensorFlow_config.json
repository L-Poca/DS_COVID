        "base_model": "ResNet50",
        "input_shape": [224, 224, 3],
        "num_classes": 4,
        "fine_tuning": true,
        "freeze_layers": 100,
        "rescaling": true,
        "data_augmentation": true,
        "global_pooling": "avg",
        "dense_layers": [512, 256],
        "dropout": 0.4,
        "dense_dropout": 0.4
      },
      "compile_config": {
        "optimizer": "adam",
        "learning_rate": 1e-5,
        "loss": "categorical_crossentropy"
      },
      "training_config": {
        "epochs": 75,
        "save_best_model": true,
        "early_stopping": true,
        "patience": 12,
        "reduce_lr": true,
        "lr_factor": 0.1,
        "lr_patience": 6,
        "tensorboard": true
      },
      "data_config": {
        "target_size": [224, 224],
        "batch_size": 16,
        "rotation_range": 15,
        "width_shift_range": 0.15,
        "height_shift_range": 0.15,
        "zoom_range": 0.15,
        "horizontal_flip": true
      }
    },
    
    "efficientnet_medical": {
      "name": "EfficientNet Médical",
      "description": "EfficientNetB0 optimisé pour images radiographiques",
      "architecture_type": "transfer_learning",
      "architecture_params": {
        "base_model": "EfficientNetB0",
        "input_shape": [224, 224, 3],
        "num_classes": 4,
        "fine_tuning": true,
        "freeze_layers": 150,
        "rescaling": false,
        "data_augmentation": false,
        "global_pooling": "avg",
        "dense_layers": [256],
        "dropout": 0.3,
        "dense_dropout": 0.2
      },
      "compile_config": {
        "optimizer": "adamax",
