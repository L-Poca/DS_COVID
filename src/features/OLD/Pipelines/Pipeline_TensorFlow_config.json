{
  "default_data_settings": {
    "target_size": [224, 224],
    "batch_size": 32,
    "class_mode": "categorical",
    "color_mode": "rgb",
    "rotation_range": 15,
    "width_shift_range": 0.1,
    "height_shift_range": 0.1,
    "shear_range": 0.1,
    "zoom_range": 0.1,
    "horizontal_flip": true,
    "fill_mode": "nearest",
    "validation_split": 0.2,
    "compute_class_weights": true
  },
  
  "model_configs": {
    "basic_cnn": {
      "name": "CNN Basique",
      "description": "Réseau de neurones convolutionnel simple pour classification COVID-19",
      "architecture_type": "custom_cnn",
      "architecture_params": {
        "input_shape": [224, 224, 3],
        "num_classes": 4,
        "rescaling": true,
        "data_augmentation": false,
        "conv_blocks": [
          {"filters": 32, "kernel_size": 3, "pool_size": 2},
          {"filters": 64, "kernel_size": 3, "pool_size": 2},
          {"filters": 128, "kernel_size": 3, "pool_size": 2}
        ],
        "dense_layers": [512, 256],
        "activation": "relu",
        "batch_normalization": true,
        "conv_dropout": 0.25,
        "dense_dropout": 0.5
      },
      "compile_config": {
        "optimizer": "adam",
        "learning_rate": 0.001,
        "loss": "categorical_crossentropy"
      },
      "training_config": {
        "epochs": 50,
        "save_best_model": true,
        "early_stopping": true,
        "patience": 10,
        "reduce_lr": true,
        "lr_factor": 0.2,
        "lr_patience": 5,
        "min_lr": 1e-7,
        "tensorboard": false
      },
      "data_config": {
        "target_size": [224, 224],
        "batch_size": 32,
        "rotation_range": 15,
        "zoom_range": 0.1,
        "horizontal_flip": true
      }
    },
    
    "advanced_cnn": {
      "name": "CNN Avancé",
      "description": "Architecture CNN plus profonde avec régularisation avancée",
      "architecture_type": "custom_cnn",
      "architecture_params": {
        "input_shape": [224, 224, 3],
        "num_classes": 4,
        "rescaling": true,
        "data_augmentation": true,
        "conv_blocks": [
          {"filters": 32, "kernel_size": 3, "pool_size": 2},
          {"filters": 64, "kernel_size": 3, "pool_size": 2},
          {"filters": 128, "kernel_size": 3, "pool_size": 2},
          {"filters": 256, "kernel_size": 3, "pool_size": 2},
          {"filters": 512, "kernel_size": 3, "pool_size": null}
        ],
        "dense_layers": [1024, 512, 256],
        "activation": "relu",
        "batch_normalization": true,
        "conv_dropout": 0.3,
        "dense_dropout": 0.5
      },
      "compile_config": {
        "optimizer": "adam",
        "learning_rate": 0.0001,
        "loss": "categorical_crossentropy"
      },
      "training_config": {
        "epochs": 100,
        "save_best_model": true,
        "early_stopping": true,
        "patience": 15,
        "reduce_lr": true,
        "lr_factor": 0.1,
        "lr_patience": 7,
        "min_lr": 1e-8,
        "tensorboard": true
      },
      "data_config": {
        "target_size": [224, 224],
        "batch_size": 16,
        "rotation_range": 20,
        "width_shift_range": 0.2,
        "height_shift_range": 0.2,
        "zoom_range": 0.2,
        "horizontal_flip": true,
        "shear_range": 0.1
      }
    },
    
    "vgg16_transfer": {
      "name": "VGG16 Transfer Learning",
      "description": "Transfer learning avec VGG16 pré-entraîné sur ImageNet",
      "architecture_type": "transfer_learning",
      "architecture_params": {
        "base_model": "VGG16",
        "input_shape": [224, 224, 3],
        "num_classes": 4,
        "fine_tuning": false,
        "freeze_layers": 15,
        "rescaling": true,
        "data_augmentation": false,
        "global_pooling": "avg",
        "dense_layers": [256, 128],
        "dropout": 0.5,
        "dense_dropout": 0.3
      },
      "compile_config": {
        "optimizer": "adam",
        "learning_rate": 0.0001,
        "loss": "categorical_crossentropy"
      },
      "training_config": {
        "epochs": 50,
        "save_best_model": true,
        "early_stopping": true,
        "patience": 10,
        "reduce_lr": true,
        "lr_factor": 0.2,
        "lr_patience": 5,
        "tensorboard": true
      },
      "data_config": {
        "target_size": [224, 224],
        "batch_size": 32,
        "rotation_range": 10,
        "zoom_range": 0.1,
        "horizontal_flip": true
      }
    },
    
    "resnet50_finetuned": {
      "name": "ResNet50 Fine-tuned",
      "description": "ResNet50 avec fine-tuning pour images médicales",
      "architecture_type": "transfer_learning",
